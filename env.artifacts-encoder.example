# Private runtime environment for scripts/artifacts-encoder.mjs.
# Keep this file separate from the app environment; it must contain no app/session/mail secrets.
DATABASE_URL=
REDIS_URL=
ARTIFACTS_S3_ENDPOINT=
ARTIFACTS_S3_BUCKET=
ARTIFACTS_S3_ACCESS_KEY=
ARTIFACTS_S3_SECRET_KEY=
