{
  "name": "inaki-lozano-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev:precompile": "node scripts/precompile.js",
    "dev": "npm-run-all --parallel dev:*",
    "prebuild": "node scripts/copy-tinymce.js",
    "build": "NEXT_BUILD_WORKERS=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "db:seed": "ts-node --project tsconfig.scripts.json scripts/init-db.ts",
    "create:admin": "ts-node --project tsconfig.scripts.json scripts/create-admin.ts",
    "seed:sections": "ts-node --project tsconfig.scripts.json scripts/seed-sections.ts",
    "seed-blogs": "ts-node --project tsconfig.scripts.json scripts/seed-blogs.ts",
    "cleanup:skill-metrics": "node scripts/cleanup-skill-metrics.js",
    "optimize:project-thumbnails": "node scripts/optimize-project-thumbnails.js",
    "test": "jest",
    "db:migrate": "node scripts/postgres-schema.cjs",
    "db:migrate:artifacts": "node scripts/artifacts-schema.cjs",
    "db:import": "node scripts/import-mongo-export.cjs",
    "test:postgres": "node --test scripts/test-postgres.cjs",
    "postinstall": "patch-package --error-on-fail",
    "test:artifacts": "node --test --test-concurrency=1 tests/artifacts/http.test.mjs",
    "test:artifacts:uploads": "node --test --test-concurrency=1 tests/artifacts/uploads.test.mjs",
    "test:artifacts:encoder": "node --test tests/artifacts/encoder.test.mjs",
    "test:artifacts:browser": "node --test tests/artifacts/browser.test.mjs",
    "test:security": "node --test scripts/test-dependency-security.cjs && node scripts/check-security-dependencies.cjs",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit --incremental false"
  },
